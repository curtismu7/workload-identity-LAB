# Real mode (owner-only). You do NOT need this file: click "Run through Privilege (Real)" on the page and paste
# the client secret once (it is saved on the Docker volume). Use this file only as an alternative, or to prefill
# the form: the three non-secret values (gateway URL, PingFederate URL, client ID) are enough for that.
# After editing: docker compose up -d. .env is gitignored and excluded from the image build.
# The secret and the real token stay on the server; the browser only ever sees decoded claims.

# The Privilege gateway host (https only)
WI_REAL_GATEWAY_URL=https://<gateway-host>
# The PingFederate that issues the agent's token (https only)
WI_REAL_PF_URL=https://<pingfederate-host>
# The PF OAuth client (grant: client_credentials) and its secret
WI_REAL_CLIENT_ID=<pf-client-id>
WI_REAL_CLIENT_SECRET=<pf-client-secret>

# Optional. Defaults shown: the Pass Agent Token agent app, the passthrough backend app, the scopes to request.
# WI_REAL_AGENT_APP=pftoken
# WI_REAL_RS_APP=pftoken-rs
# WI_REAL_SCOPES=opensearch:read whoami:read
